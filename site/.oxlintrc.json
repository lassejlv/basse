{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/routeTree.gen.ts"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": ["warn", { "additionalHooks": "useEffectFiber" }],
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["Route", "buttonVariants"] }]
  }
}
